{
  "name": "roxy-mobile",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8083 --clear",
    "web:export": "expo export --platform web",
    "web:serve": "npx --yes serve@14 -s dist -l 4173",
    "web:deploy": "npm run web:export && node -e \"const f=require('fs');f.copyFileSync('vercel.dist.json','dist/vercel.json');f.copyFileSync('vercelignore.dist','dist/.vercelignore')\" && cd dist && npx vercel link --yes --project roxy-web --scope team_0HiBgsTPVZVWgzW5UyBwtn8W && npx vercel deploy --prod --yes --scope team_0HiBgsTPVZVWgzW5UyBwtn8W",
    "test": "jest --watchAll",
    "test:ci": "jest --ci",
    "lint": "eslint . --ext .ts,.tsx",
    "eas": "eas",
    "eas:build:preview": "eas build --profile preview --platform android",
    "eas:build:list": "eas build:list --profile preview --limit 5",
    "eas:build:run": "eas build:run --profile preview --platform android --latest",
    "test:e2e": "playwright test",
    "test:e2e:audit": "playwright test tests/e2e/content-feed-audit.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@daily-co/react-native-daily-js": "^0.83.0",
    "@daily-co/react-native-webrtc": "^124.0.6-daily.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-firebase/analytics": "^20.0.0",
    "@react-native-firebase/app": "^20.0.0",
    "@react-native-firebase/crashlytics": "^20.0.0",
    "@shopify/flash-list": "1.6.4",
    "@stripe/stripe-react-native": "0.37.2",
    "@supabase/supabase-js": "^2.105.4",
    "date-fns": "^3.6.0",
    "eas": "^0.1.0",
    "expo": "~51.0.0",
    "expo-application": "~5.9.1",
    "expo-asset": "~10.0.0",
    "expo-av": "~14.0.0",
    "expo-build-properties": "~0.12.5",
    "expo-constants": "~16.0.0",
    "expo-dev-client": "~4.0.0",
    "expo-device": "~6.0.2",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.0",
    "expo-image": "~1.13.0",
    "expo-image-picker": "~15.1.0",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~6.3.0",
    "expo-localization": "~15.0.3",
    "expo-notifications": "~0.28.0",
    "expo-router": "~3.5.0",
    "expo-sharing": "~12.0.1",
    "expo-status-bar": "~1.12.1",
    "posthog-react-native": "^4.39.4",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.74.5",
    "react-native-background-timer": "^2.4.1",
    "react-native-gesture-handler": "~2.16.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~3.10.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.19.13",
    "react-native-webview": "13.8.6",
    "rn-emoji-keyboard": "^1.7.0",
    "supabase": "^2.99.0",
    "zustand": "^4.5.0"
  },
  "overrides": {
    "protobufjs": "^7.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~18.2.0",
    "@types/react-native": "~0.73.0",
    "ajv": "^8.18.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~7.1.2",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.0",
    "typescript": "~5.3.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@react-native-firebase/(.*)$": "<rootDir>/__mocks__/@react-native-firebase/$1.js",
      "^posthog-react-native$": "<rootDir>/__mocks__/posthog-react-native.js",
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock",
      "^@stripe/stripe-react-native$": "<rootDir>/__mocks__/@stripe/stripe-react-native.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@daily-co/.*|@shopify/.*)"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/tests/e2e/"
    ],
    "globalSetup": "./jest.setup.env.js"
  }
}
